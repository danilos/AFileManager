; AFileManager live/release startup descriptor.
; 0.15.0.2.2.0: self-contained on purpose.  The live package must not depend
; on a development-only descriptors/ subdrawer merely to construct its UI.

; AFileManager release descriptor.
; Self-contained release feature authority. Development capability descriptors
; remain available independently; this file intentionally has no Inherits chain.
; Features may be enabled/disabled here for a particular release without changing code.

[Window]
Resizable=true
Title=@afilemanager_window_title
Width=1100
Height=700
MinWidth=760
MinHeight=470
Theme=Dark
Localization=System
Language=System

[Capabilities]
Frame=true
Menu=true
Preview=true
ContextMenu=true
Status=true
Shortcuts=true
NavigationHistory=true
Gadgets=true
Toolbar=true
SplitView=true
Operations=true
CommandLine=false
Theme=true
Localization=true

[Layout]
Panels=Places,CurrentLocation
PersistentPanelWidths=true

[Panel.Places]
Order=10
Width=220
MinimumWidth=120
Resizable=true

[Panel.CurrentLocation]
Order=20
MinimumWidth=300
Weight=1
Resizable=true

[CurrentLocation]
View=@afilemanager_view_details
SortBy=Name
SortDirection=Ascending
DirectoriesFirst=true
InitialLocation=Desktop
ViewMode=Icons
ShowHiddenFiles=false

[Locations]
Groups=Desktop,Favorites,RecentLocations,RecentFiles,Assigns,Network,Devices

[Locations.Desktop]
Desktop=arosa://desktop
Provider=System.UserLocations
Downloads=SYS:Work/Downloads

[Locations.Favorites]
Provider=AFileManager.Favorites
AFileManager=PROGDIR:
[Locations.RecentLocations]
Provider=AFileManager.RecentLocations
MaxEntries=10

[Locations.RecentFiles]
Provider=AFileManager.RecentFiles
MaxEntries=10

[Locations.Assigns]
Provider=System.Assignments

[Locations.Network]
Provider=System.NetworkLocations
HOST=atransfer://192.168.1.31:8080/Uploads

[Locations.Devices]
Provider=System.Devices

[Configuration]
UserConfig=../configurations/default.user

[DetailsView]
Columns=Type,Name,Size,Modified,Permissions

[Fonts]
; Application font roles. User profiles may override these independently.
UIFamily=system
UISize=12
FileFamily=system
FileSize=10
FixedFamily=courier
FixedSize=12
DocumentFamily=system
DocumentSize=10
InfoFamily=system
InfoSize=11

[FileView]
VisibleColumns=resource.thumbnail,resource.type,resource.name,resource.size,resource.modified,resource.permissions
ColumnOrder=resource.thumbnail,resource.type,resource.name,resource.size,resource.modified,resource.permissions
DefaultSortColumn=resource.name
DefaultSortAscending=true
ShowThumbnails=true
ThumbnailSize=16
IconSize=24
; Compact image thumbnail target for future list/details thumbnail binding.

RowPadding=3
IconTextGap=6
WindowsIconSize=48
WindowsCellWidth=112
WindowsCellHeight=94

[Column.Type]
Caption=@afilemanager_column_type
Order=10
Visible=true
Width=72

[Column.Name]
Caption=@afilemanager_column_name
Order=20
Visible=true
Width=260

[Column.Size]
Caption=@afilemanager_column_size
Order=30
Visible=true
Width=76

[Column.Modified]
Caption=@afilemanager_column_modified
Order=40
Visible=true
Width=138

[Column.Permissions]
Caption=@afilemanager_column_permissions
Order=50
Visible=true
Width=96

[Preview]
Placement=Bottom
Height=120
Width=260
ContentPercent=70
RemoteAutoLoadKB=8192

[Search]
Recursive=true
IncludeFiles=true
IncludeFolders=true
CaseSensitive=false
MaxResults=2000
SimpleSubstring=true

; ---- 0.8.6.1 optional behaviour (commented = the built-in default) ----------
; Drag feedback: outline of the carried rows, outline of the drop target and
; the caption beside the pointer.  false switches all three off; dragging
; itself is not affected.
;[DragDrop]
;Feedback=true
;
; "Create folder" offers to write the drawer's .info icon.  This is the
; state of that tick box the first time the dialog is shown in a session.
;[Files]
;NewFolderIcon=true
;
; Theme role used for the names of remote locations and of the files listed
; from them.  Any theme role name; "none" switches the colouring off.
;[Panes]
;RemoteRole=RemoteLocation

[Diagnostics]
Logging=true

Level=Info
[Gadgets]
Menu=true
Close=true
Minimize=true
Maximize=true
Restore=true

[Visibility]
Preview=false
Toolbar=true
SplitView=false
Operations=false
Metadata=false

[Menu]
Theme.Dark=@afilemanager_menu_theme_dark_checked
Theme.Light=@afilemanager_menu_theme_light_unchecked
View.Preview=Panels
View.Toolbar=Toolbar
