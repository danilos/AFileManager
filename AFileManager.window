Resource.Metadata=@afilemanager_action_metadata
Resource.EditPermissions=@afilemanager_action_edit_permissions
History.Undo=@afilemanager_action_undo

[Shortcuts]
Ctrl+T=View.NewFileManager
Ctrl+W=View.CloseFileManager
Alt+Left=Navigation.Back
Alt+Right=Navigation.Forward
F5=Navigation.Refresh
Ctrl+A=Selection.All
Ctrl+Shift+A=Selection.None
Ctrl+C=Resource.Copy
Ctrl+X=Resource.Cut
Ctrl+V=Resource.Paste
Delete=File.Delete
F2=Resource.Rename
Ctrl+Shift+N=Resource.CreateFolder
Ctrl+N=Resource.CreateFile
Ctrl+Z=History.Undo
F1=Help.Contents

[Presentation]
Theme=Dark
AvailableThemes=Dark,Light

[ConsolePresentation]
; Semantic theme roles used by the Console. The theme resolves actual colours.
BackgroundRole=EditorBackground
TextRole=PrimaryText
SearchMatchRole=Warning
SearchCurrentRole=Accent
ColumnDividerRole=Border

[Spectrum]
; Left-to-right low -> high frequency semantic palette.
LowRole=Hint
LowMidRole=Information
HighMidRole=Warning
HighRole=Error

[Editor]
Descriptor=Arosa.Editor.preview
WordWrap=false
LineNumbers=false
Highlighting=true
Search=true
Replace=true
GoToLine=true
ContextMenu=true

[Bubbles]
Enabled=true
HoverDelayMs=1500
LeaveGraceMs=350
MaxWidth=320
Padding=6
CornerRadius=8
Opacity=88

[Bubbles.Dark]

[Bubbles.Light]

