[IconAliases]
; Semantic AROSA icon name -> artwork resource name in themes/default/icons/svg.
; Exact-name SVGs always win. These aliases are only used when the semantic
; filename itself is absent; existing PNG resources remain the final fallback.
nav-up=folder-up
search=find
window-zoom=maximize-window
guide-contents=documentation

