; Console (Operations panel).  A line that is not an AFileManager command id
; runs in the console's location: AmigaDOS commands on AROS, sh on Linux,
; cmd on Windows; remote locations offer ls/dir/list, cd, pwd, info, help.
[Console]
; a command still running after this many seconds is stopped
TimeoutSeconds=30
ScrollbackLines=5000
WordWrap=true
Highlighting=true

; ----------------------------------------------------------------------
; 0.7.9.0.0 environment-specific command surfaces.
; Visibility remains governed by [Visibility] and the burger toggles. These
; sections only replace the CONTENT of the existing toolbar/operations hosts
; while a Console document is active.
; ----------------------------------------------------------------------
[Environment.Console.Toolbar]
; Top console surface contains tools only. Page names are deliberately
; semantic: View changes presentation; Buffers manages console sessions.
View.Console.Wrap=Wrap
View.Console.ColumnLess=C-
View.Console.ColumnMore=C+
View.Console.FontSmaller=A-
View.Console.FontLarger=A+
View.Console.New=New
View.Console.Close=Close
Buffers.Console.New=New console
Buffers.Console.Close=Close console
Buffers.Console.Clear=Clear

[Environment.Console.Operations]
; Lower surface contains command-support operations. Search is a Commands
; action; history and environment keep their own pages.
Commands.Console.Search=Search
History.Console.Previous=Previous
History.Console.Next=Next
Environment.Console.Info=Shell / location

[Environment.Console.Toolbar]
View.Console.Wrap=Wrap
View.Console.ColumnLess=C-
View.Console.ColumnMore=C+
View.Console.FontSmaller=A-
View.Console.FontLarger=A+
View.Console.New=New
View.Console.Close=Close
Buffers.Console.New=New console
Buffers.Console.Close=Close console
Buffers.Console.Clear=Clear

[ConsolePresentation]
ColumnDividerRole=Border
