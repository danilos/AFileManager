;Information=#RRGGBB
;GitModified=#RRGGBB
;GitAdded=#RRGGBB
;GitDeleted=#RRGGBB
;TitleBarBackground=#RRGGBB
;StatusBarBackground=#RRGGBB
;TabActive=#RRGGBB
;TabInactive=#RRGGBB
;OnAccent=#RRGGBB
;DisabledText=#RRGGBB
;Divider=#RRGGBB
;InputBackground=#RRGGBB
;MenuBarBackground=#RRGGBB
;MenuBackground=#RRGGBB
;MenuItemText=#RRGGBB
;ShortcutText=#RRGGBB
;ScrollbarTrack=#RRGGBB
;ScrollbarThumb=#RRGGBB
;Shadow=#RRGGBB
;Scrim=#RRGGBB
; names of remote locations and of files listed from them
;RemoteLocation=#RRGGBB
;BubbleBackground=#RRGGBB
